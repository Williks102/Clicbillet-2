# GEMINI_API_KEY: Clé API pour les fonctionnalités IA de Gemini.
# AI Studio l'injecte automatiquement au moment de l'exécution à partir de vos secrets.
GEMINI_API_KEY=""

# ORIGINE PUBLIQUE DE L'APPLICATION :

# Domaine canonique servi au public, sans barre finale. Cette valeur n'est JAMAIS déduite des
# en-têtes Host/Origin de la requête (usurpables) : elle construit des URL sensibles, et une
# valeur erronée est silencieuse — rien ne casse visiblement, mais tout pointe ailleurs.
#
# Elle sert à :
#   - le lien de réinitialisation de mot de passe envoyé par email (le plus critique : un
#     mauvais domaine y envoie un jeton valide hors de chez vous) ;
#   - la redirection de confirmation d'email de Supabase Auth. Cette même URL doit alors
#     figurer dans Supabase > Authentication > URL Configuration > Redirect URLs, sinon
#     Supabase refuse la redirection ;
#   - les aperçus de partage des pages d'événement (og:url et og:image), donc l'affiche et le
#     titre qui s'affichent quand un lien est envoyé sur WhatsApp.
#
# Non définie, la production retombe sur ce même domaine canonique et le démarrage le signale
# dans les journaux. La définir explicitement reste préférable : le repli est écrit en dur et
# ne suivra pas un changement de domaine.
APP_ORIGIN="https://www.clicbillet.com"

# SUPABASE CONFIGURATION:
# Vous pouvez configurer les deux variables ci-dessous pour l'application.
# (Notre backend Express est compatible avec les variables standards et celles préfixées par VITE_).

# URL de votre projet Supabase (ex: https://satvespjethrqgiwsfov.supabase.com)
VITE_SUPABASE_URL=""

# Clé API publique (Anon Key) ou clé de rôle de service (Service Role Key)
VITE_SUPABASE_PUBLISHABLE_KEY=""

# PAYSTACK CONFIGURATION:
# Clé publique Paystack (préfixe pk_test_/pk_live_), utilisée côté navigateur par le popup
# Paystack Inline. Trouvable dans Dashboard Paystack > Settings > API Keys & Webhooks.
VITE_PAYSTACK_PUBLIC_KEY=""

# Clé secrète Paystack (préfixe sk_test_/sk_live_), utilisée côté serveur pour vérifier une
# transaction (GET /transaction/verify) et pour valider la signature des webhooks entrants
# (HMAC-SHA512 du corps brut, header x-paystack-signature). NE JAMAIS exposer côté client.
PAYSTACK_SECRET_KEY=""

# Configurez l'URL de webhook suivante dans Dashboard Paystack > Settings > API Keys & Webhooks :
# https://<votre-domaine>/api/webhooks/paystack

# Paystack n'autorise qu'UNE SEULE URL de webhook par compte marchand. Si ce compte est
# partagé avec une autre application (dont les références de transaction n'utilisent jamais
# le préfixe "ORD-" de ClicBillet), renseignez ici son URL de webhook : tout événement Paystack
# qui n'est pas un ordre ClicBillet lui sera relayé tel quel (corps brut + signature d'origine).
# Laissez vide si ClicBillet est seul sur ce compte Paystack.
PAYSTACK_FOREIGN_WEBHOOK_FORWARD_URL=""

# EMAILS TRANSACTIONNELS (Resend) :

# Clé API Resend (https://resend.com/api-keys). Si vide, les emails sont simplement
# loggués en console (mode mock), aucune route métier n'est bloquée.
RESEND_API_KEY=""

# Adresse/nom d'expéditeur utilisé pour tous les emails envoyés par l'application
# (doit correspondre à un domaine vérifié sur Resend en production).
RESEND_FROM_EMAIL="ClicBillet <no-reply@monticket.online>"

# Adresse email recevant les notifications admin (nouvel organisateur, demande de retrait).
ADMIN_NOTIFICATION_EMAIL="admin@monticket.online"

# Secret partagé utilisé pour valider que les appels vers /api/webhooks/supabase/new-user
# viennent bien du Database Webhook configuré dans le dashboard Supabase (cf. supabase_setup.sql, section 9).
SUPABASE_WEBHOOK_SECRET=""

# EXPIRATION DES BILLETS EN ATTENTE DE PAIEMENT :

# Nombre de minutes au-delà duquel un billet resté "PENDING-" (paiement jamais confirmé) est
# annulé automatiquement, libérant les places qu'il réservait. Par défaut : 30 minutes.
PENDING_TICKET_EXPIRY_MINUTES="30"

# POLITIQUE DE RÉTENTION DES DONNÉES (cf. supabase_setup.sql, section 16) :

# Nombre de jours au-delà duquel un panier abandonné/échoué ("EXPIRED-"/"FAILED-", jamais payé)
# est définitivement supprimé par la même route de cron ci-dessous. Ne concerne jamais les
# billets payés. Par défaut : 90 jours.
ABANDONED_TICKET_RETENTION_DAYS="90"

# La route GET /api/cron/expire-pending-tickets doit être appelée périodiquement (ex: toutes les
# 10 min) par un planificateur externe — PAS par Vercel Cron, dont le compte utilisé partage déjà
# son quota de Cron Jobs avec une autre application, ce qui fait échouer le déploiement si on en
# ajoute un ici (cf. vercel.json, section "crons" retirée). Utilisez un service gratuit comme
# https://cron-job.org, GitHub Actions (workflow planifié), ou tout autre planificateur capable
# d'envoyer une requête HTTP GET avec un header personnalisé.
#
# Configurez-le pour appeler :
#   GET https://<votre-domaine>/api/cron/expire-pending-tickets
#   Header : Authorization: Bearer <la même valeur que CRON_SECRET ci-dessous>
#
# Générez une valeur aléatoire (ex: openssl rand -hex 32) et renseignez-la aussi bien ici que
# dans la configuration du planificateur externe. Laissez vide en développement local (aucune
# vérification alors appliquée) — mais définissez-la obligatoirement en production, sinon la
# route reste accessible sans authentification à quiconque connaît son URL.
CRON_SECRET=""
