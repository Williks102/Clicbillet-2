{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs && npm run check:secrets",
    "preview": "vite preview",
    "clean": "rm -rf dist build server.js",
    "lint": "tsc --noEmit",
    "start": "node build/server.cjs",
    "check:secrets": "node scripts/check-build-secrets.mjs",
    "migrate:compress-banners": "node scripts/compress-existing-banners.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@google/genai": "^2.28.0",
    "@sentry/node": "^10.76.2",
    "@sentry/react": "^10.76.2",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.11",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^6.0.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "vite": "^6.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0"
  }
}
